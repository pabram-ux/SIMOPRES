<!DOCTYPE html>
<html lang="es"> 
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no">
    <title>Monitor Ejecutivo Presupuestario | GAMSB</title>
    <meta name="description" content="SIMOPRES PRO - Sistema Integrado de Monitorización Presupuestaria del Gobierno Autónomo Municipal de San Borja (GAMSB)." />
    <meta property="og:title" content="Monitor Ejecutivo Presupuestario | GAMSB" />
    <meta property="og:description" content="SIMOPRES PRO - Sistema Integrado de Monitorización Presupuestaria del Gobierno Autónomo Municipal de San Borja (GAMSB)." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Scripts Externos (CDNs) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');

        :root {
            --font-sans: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --bg-app: #020617;
            --text-main: #f1f5f9;
            --panel-bg: rgba(15, 23, 42, 0.8);
            --border-panel: rgba(51, 65, 85, 0.5);
            --card-bg: #0f172a;
            --card-border: #1e293b;
            --inner-relief: #020617;
        }

        .dark-mode {
            --bg-app: #020617;
            --text-main: #f1f5f9;
            --panel-bg: rgba(15, 23, 42, 0.8);
            --border-panel: rgba(51, 65, 85, 0.5);
            --card-bg: #0f172a;
            --card-border: #1e293b;
            --inner-relief: #020617;
        }

        .green-mode {
            --bg-app: #020d06;
            --text-main: #e2f0e7;
            --panel-bg: rgba(6, 26, 14, 0.85);
            --border-panel: rgba(16, 70, 36, 0.5);
            --card-bg: #041f0f;
            --card-border: #0b3d1f;
            --inner-relief: #010703;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            background-color: var(--bg-app);
            color: var(--text-main);
            font-family: var(--font-sans);
            font-size: 14px;
            transition: background-color 0.5s ease, color 0.5s ease;
        }

        #root {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
        }

        @media (max-width: 640px) {
            html, body { font-size: 12px; }
        }

        /* Estilos Avanzados de Relieve y Cristal */
        .glass-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(24px);
            border: 1px solid var(--border-panel);
            box-shadow: 
                0 4px 6px -1px rgba(0, 0, 0, 0.05), 
                0 10px 40px -5px rgba(0, 0, 0, 0.1),
                inset 0 1px 1px var(--border-panel);
            position: relative;
            overflow: hidden;
        }

        .relief-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            box-shadow: 
                0 10px 15px -3px rgba(0, 0, 0, 0.05),
                0 4px 6px -2px rgba(0, 0, 0, 0.03);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .relief-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 
                0 30px 60px -12px rgba(0, 0, 0, 0.2),
                0 18px 36px -18px rgba(0, 0, 0, 0.2);
            border-color: #3b82f6;
        }

        .inner-relief {
            box-shadow: inset 4px 4px 12px rgba(0, 0, 0, 0.08), inset -4px -4px 12px rgba(255, 255, 255, 0.02);
            background: var(--inner-relief);
        }

        .dark-mode .inner-relief {
            box-shadow: inset 4px 4px 12px rgba(0, 0, 0, 0.5), inset -4px -4px 12px rgba(255, 255, 255, 0.01);
        }

        .neon-glow-blue {
            border-color: rgba(59,130,246,0.3);
            box-shadow: 0 10px 25px -5px rgba(59,130,246,0.15);
        }

        .neon-glow-rose {
            border-color: rgba(244,63,94,0.3);
            box-shadow: 0 10px 25px -5px rgba(244,63,94,0.15);
        }

        @keyframes scanline {
            0% { transform: translateY(-100%); opacity: 0; }
            50% { opacity: 0.5; }
            100% { transform: translateY(1000%); opacity: 0; }
        }
        
        .scanline {
            position: absolute; top: 0; left: 0; width: 100%; height: 100px;
            background: linear-gradient(to bottom, transparent, rgba(59, 130, 246, 0.1), transparent);
            animation: scanline 8s linear infinite; pointer-events: none;
        }

        .green-mode .relief-card:hover {
            border-color: #10b981;
        }

        .green-mode .scanline {
            background: linear-gradient(to bottom, transparent, rgba(16, 185, 129, 0.1), transparent);
        }

        .green-mode .neon-glow-blue {
            border-color: rgba(16, 185, 129, 0.3);
            box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.15);
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }

        /* Animation for pulse alerts */
        @keyframes subtle-pulse {
            0% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(1); opacity: 0.8; }
        }
        .alert-pulse { animation: subtle-pulse 2s infinite ease-in-out; }

        /* Responsive Modal Fixes */
        .modal-container {
            max-height: 90vh;
            overflow-y: auto;
            scrollbar-width: thin;
        }
        .modal-container::-webkit-scrollbar { width: 4px; }
        .modal-container::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    
        /* =========================
           DONUTS PREMIUM 3D
        ========================= */

        @keyframes donutFloat {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
            100% { transform: translateY(0px); }
        }

        @keyframes donutGlow {
            0% { filter: drop-shadow(0 0 10px rgba(59,130,246,0.3)); }
            50% { filter: drop-shadow(0 0 30px rgba(59,130,246,0.7)); }
            100% { filter: drop-shadow(0 0 10px rgba(59,130,246,0.3)); }
        }

        canvas {
            animation:
                donutFloat 5s ease-in-out infinite,
                donutGlow 4s ease-in-out infinite;
        }

</style>
</head>
<body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
</body>
</html>
